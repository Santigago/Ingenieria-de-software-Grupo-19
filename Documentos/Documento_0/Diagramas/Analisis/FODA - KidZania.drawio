<mxfile host="ParkFlow"><diagram name="FODA" id="foda"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pos" value="Aspectos positivos" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;strokeColor=#333333;fillColor=#E7E6E6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="10" width="379" height="30" as="geometry"/></mxCell><mxCell id="neg" value="Aspectos negativos" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;strokeColor=#333333;fillColor=#E7E6E6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="431" y="10" width="379" height="30" as="geometry"/></mxCell><mxCell id="rot0" value="Análisis interno" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;strokeColor=#333333;fillColor=#E7E6E6;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="1"><mxGeometry x="10" y="44" width="34" height="196" as="geometry"/></mxCell><mxCell id="rot1" value="Análisis externo" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;strokeColor=#333333;fillColor=#E7E6E6;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="1"><mxGeometry x="10" y="244" width="34" height="196" as="geometry"/></mxCell><mxCell id="c0" value="&lt;div style=&quot;font-weight:bold;font-size:16px;text-align:center;margin-bottom:6px&quot;&gt;Fortalezas&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:18px;text-align:left&quot;&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Público cautivo y flujo constante de familias&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Marca reconocida a nivel internacional&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Recinto bajo techo, que opera sin depender del clima&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Ubicación en un sector de alto tránsito familiar&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;ERP SAP Business One ya implementado en la bodega&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;strokeColor=#333333;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;fontSize=12;spacingTop=8;spacingLeft=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="48" y="44" width="379" height="196" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style=&quot;font-weight:bold;font-size:16px;text-align:center;margin-bottom:6px&quot;&gt;Debilidades&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:18px;text-align:left&quot;&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Sistema de punto de venta genérico, poco adaptado a la operación rápida de los puestos&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Catálogo de la caja no diferenciado por puesto (comida o merch)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Reposición de los puestos a bodega sin seguimiento integrado con SAP&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Comandas impresas en papel, sin seguimiento del estado del pedido&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Pocos indicadores en tiempo real para la administración&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;strokeColor=#333333;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;fontSize=12;spacingTop=8;spacingLeft=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="431" y="44" width="379" height="196" as="geometry"/></mxCell><mxCell id="c2" value="&lt;div style=&quot;font-weight:bold;font-size:16px;text-align:center;margin-bottom:6px&quot;&gt;Oportunidades&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:18px;text-align:left&quot;&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Un POS a la medida, táctil y simple, que acelere la atención&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Integración con la API de SAP para reponer stock sin digitar&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Uso de los datos de venta para definir precios, combos y compras&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Menús saludables alineados con la tendencia de alimentación infantil&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;strokeColor=#333333;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;fontSize=12;spacingTop=8;spacingLeft=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="48" y="244" width="379" height="196" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;font-weight:bold;font-size:16px;text-align:center;margin-bottom:6px&quot;&gt;Amenazas&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:18px;text-align:left&quot;&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Estacionalidad de la demanda&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Alza de costos de insumos y mercadería (inflación)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Regulaciones de etiquetado y plásticos más exigentes&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px&quot;&gt;Caídas de conectividad que paralicen la venta o la sincronización con SAP&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;strokeColor=#333333;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;fontSize=12;spacingTop=8;spacingLeft=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="431" y="244" width="379" height="196" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>